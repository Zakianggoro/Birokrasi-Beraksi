      m_Calls: []
  m_text: "\tDilaporkan bahwa pada tanggal 1 Juli 2024, telah hilang STNK atas nama
    Mulyono dengan NIK 35071220780007.\nSelanjutnya keterangan ini dikeluarkan dan
    dipergunakan untuk :\nKlaim asuransi dan pengurusan surat kendaraan.\t\n\n\t  
    Pemohon \t\t\t\t\t\tYang Mengetahui\n\n\n\t    Mulyono\t\t\t\t\t\t     Kepala
    Desa"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
